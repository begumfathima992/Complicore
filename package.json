{
  "name": "hrms-sponsor-compliance-system",
  "version": "0.1.0",
  "description": "HR & Sponsor Compliance Management System - backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:sync": "node scripts/syncDb.js",
    "db:seed": "node scripts/seedRoles.js",
    "db:seed:prod": "node scripts/seedProduction.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "alerts:sync": "node scripts/generateAlerts.js",
    "alerts:email": "node scripts/sendExpiryAlertEmails.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.38.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

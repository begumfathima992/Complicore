NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms_compliance
DB_USER=postgres
DB_PASSWORD=changeme

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SITE_ORIGIN=http://localhost:5173

# Neon database (pooled, used by the app)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# Neon direct connection (used for migrations)
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Cloudflare R2 (EU jurisdiction) for documents
R2_ENDPOINT=https://<account_id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET=hrms-documents
R2_REGION=auto

# Email alerts (Resend)
RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM=HRMS Compliance <alerts@yourdomain.example>

# First Super Admin for the production seed
SUPERADMIN_EMAIL=admin@yourdomain.example
SUPERADMIN_PASSWORD=replace_with_a_strong_password
